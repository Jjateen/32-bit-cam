// Tang Nano 9K pin constraints for the CAM demo
IO_LOC "clk_in" 52;
IO_PORT "clk_in" PULL_MODE=UP;
IO_LOC "btn_s1" 3;
IO_PORT "btn_s1" PULL_MODE=UP;
IO_LOC "btn_s2" 4;
IO_PORT "btn_s2" PULL_MODE=UP;
IO_LOC "leds[4]" 15;
IO_PORT "leds[4]" PULL_MODE=UP DRIVE=8;
IO_LOC "leds[3]" 14;
IO_PORT "leds[3]" PULL_MODE=UP DRIVE=8;
IO_LOC "leds[2]" 13;
IO_PORT "leds[2]" PULL_MODE=UP DRIVE=8;
IO_LOC "leds[1]" 11;
IO_PORT "leds[1]" PULL_MODE=UP DRIVE=8;
IO_LOC "leds[0]" 10;
IO_PORT "leds[0]" PULL_MODE=UP DRIVE=8;
IO_LOC "uart_tx" 17;
IO_PORT "uart_tx" PULL_MODE=UP DRIVE=8;
